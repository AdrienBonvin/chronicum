{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9]{5}$/)",
        ".write": "auth != null && !newData.exists() && root.child('roomsSeen').child($code).val() < now - 86400000",
        "createdAt": {
          ".write": "auth != null && !data.exists() && $code.matches(/^[A-HJ-NP-Z2-9]{5}$/)",
          ".validate": "newData.isNumber()"
        },
        "seats": {
          "$seat": {
            ".write": "auth != null && ($seat === '1' || $seat === '2') && root.child('rooms').child($code).child('createdAt').exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        },
        "boards": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('createdAt').exists()",
            ".validate": "newData.val() === true"
          }
        },
        "phones": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('createdAt').exists()",
            ".validate": "newData.val() === true"
          }
        },
        "ended": {
          ".write": "auth != null && (root.child('rooms').child($code).child('seats/1').val() === auth.uid || root.child('rooms').child($code).child('seats/2').val() === auth.uid || root.child('rooms').child($code).child('boards').child(auth.uid).exists())",
          ".validate": "newData.val() === true"
        },
        "state": {
          ".write": "auth != null && (root.child('rooms').child($code).child('seats/1').val() === auth.uid || root.child('rooms').child($code).child('seats/2').val() === auth.uid || root.child('rooms').child($code).child('boards').child(auth.uid).exists())",
          ".validate": "newData.isString() && newData.val().length < 200000"
        },
        "photos": {
          ".write": "auth != null && ((root.child('rooms').child($code).child('seats/1').val() === auth.uid || root.child('rooms').child($code).child('seats/2').val() === auth.uid || root.child('rooms').child($code).child('boards').child(auth.uid).exists()) || (!newData.exists() && root.child('photoRooms').child($code).val() < now - 172800000))",
          "$key": {
            ".validate": "$key.matches(/^[a-z0-9]{1,20}_[0-59]_[12]$/) && newData.hasChildren(['at', 'data'])",
            "at": {
              ".validate": "newData.isNumber()"
            },
            "data": {
              ".validate": "newData.isString() && newData.val().length < 1000000 && newData.val().beginsWith('data:image/jpeg;base64,')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "photoRooms": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9]{5}$/) && ((root.child('rooms').child($code).child('seats/1').val() === auth.uid || root.child('rooms').child($code).child('seats/2').val() === auth.uid || root.child('rooms').child($code).child('boards').child(auth.uid).exists()) || (!newData.exists() && data.val() < now - 172800000))",
        ".validate": "newData.isNumber() && newData.val() <= now"
      }
    },
    "feedback": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['text', 'at'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 1000"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "app": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "screen": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomsSeen": {
      ".read": "auth != null && query.orderByValue == true && query.startAt == null && query.limitToFirst <= 20",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z2-9]{5}$/) && ((root.child('rooms').child($code).child('seats/1').val() === auth.uid || root.child('rooms').child($code).child('seats/2').val() === auth.uid || root.child('rooms').child($code).child('boards').child(auth.uid).exists()) || (!newData.exists() && data.val() < now - 86400000))",
        ".validate": "newData.isNumber() && newData.val() <= now"
      }
    }
  }
}
